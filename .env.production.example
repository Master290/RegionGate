# Generate both values independently. Do not commit the populated .env file.
REGIONGATE_VELOCITY_SECRET=replace-with-a-long-random-forwarding-secret
REGIONGATE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

REGIONGATE_BIND_ADDRESS=0.0.0.0
REGIONGATE_PORT=25565
REGIONGATE_MAX_CONNECTIONS=10000
REGIONGATE_MAX_CONNECTIONS_PER_IP=8
REGIONGATE_MAX_PACKET_SIZE=2097152
REGIONGATE_HANDSHAKE_TIMEOUT=10s
REGIONGATE_STATUS_TIMEOUT=10s
REGIONGATE_LOGIN_TIMEOUT=30s
REGIONGATE_WRITE_TIMEOUT=10s
REGIONGATE_KEEPALIVE_INTERVAL=15s
REGIONGATE_KEEPALIVE_TIMEOUT=30s
REGIONGATE_QUEUE_SIZE=1024
REGIONGATE_ADMISSION_INTERVAL=1s
REGIONGATE_QUEUE_STATUS_INTERVAL=1s
REGIONGATE_CHALLENGE_TIMEOUT=10s
REGIONGATE_LOGIN_RATE_LIMIT=10
REGIONGATE_LOGIN_RATE_WINDOW=10s
REGIONGATE_CONFIG_FILE=

REGIONGATE_MEMORY_LIMIT=256m
REGIONGATE_CPU_LIMIT=1.0
PAPER_MEMORY=2G
PAPER_MEMORY_LIMIT=3g
PAPER_CPU_LIMIT=2.0
